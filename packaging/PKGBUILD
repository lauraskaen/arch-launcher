# Local PKGBUILD: builds the package from this source tree.
#   cd packaging && makepkg -si
pkgname=arch-launcher
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast GTK4 application launcher with per-launcher app hiding (Wayland & X11)"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('flatpak: launch Flatpak applications')
options=('!lto')
source=()

_srcroot() { realpath "$startdir/.."; }

prepare() {
  cd "$(_srcroot)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_srcroot)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$(_srcroot)"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen
}

package() {
  cd "$(_srcroot)"
  make install DESTDIR="$pkgdir" PREFIX=/usr BIN="$srcdir/target/release/arch-launcher"
}
